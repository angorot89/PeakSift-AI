# PeakSift production stack settings (docker-compose.prod.yml). Copy to deploy/.env and
# replace EVERY value; never commit deploy/.env. Generate secrets with e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# The public HTTPS origin and its host name (the certificate must match it).
PUBLIC_URL=https://peaksift.example.com
PUBLIC_HOST=peaksift.example.com
HTTP_PORT=80
HTTPS_PORT=443

SECRET_KEY=replace-with-48-random-characters
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

# MinIO administrator (used only to create the bucket and the application user) and the
# application's own key, limited to the bucket.
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me-at-least-8-characters
S3_BUCKET=peaksift-media
S3_APP_ACCESS_KEY=replace-me
S3_APP_SECRET_KEY=replace-me-at-least-8-characters

# Transcription and clip detection (see backend/.env.example for every option).
TRANSCRIPTION_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=small
CLIP_DETECTION_OLLAMA_ENABLED=false
OPENAI_API_KEY=

# Publishing to YouTube (docs/youtube-setup.md). Off until all of these are set.
YOUTUBE_PUBLISHING_ENABLED=false
PUBLISHING_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Performance analytics (V1.4): needs publishing, the YouTube Data API v3 and the YouTube
# Analytics API enabled on the same Google project; creators opt in one by one.
YOUTUBE_ANALYTICS_ENABLED=false
