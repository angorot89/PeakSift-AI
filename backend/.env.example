# Copy to `.env` and fill in values. Never commit `.env`.

# development | test | production. Production refuses to start on unsafe settings: an HTTPS
# FRONTEND_URL, explicit ALLOWED_HOSTS (no wildcards), DATABASE_URL, REDIS_URL and an absolute
# MEDIA_ROOT are required, and SECRET_KEY must be a real random secret (never a placeholder).
APP_ENV=development
# Host names the API answers to, comma-separated (required in production), e.g. api.example.com
# ALLOWED_HOSTS=
# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (IPs or CIDRs).
# TRUSTED_PROXIES=

# Origin allowed by CORS (the Next.js dev server).
FRONTEND_URL=http://localhost:3000

# SQLAlchemy connection URL. The example below matches the Docker Compose database.
# For a local PostgreSQL that trusts your OS user: postgresql+psycopg://localhost:5432/peaksift
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/peaksift

# Separate database used by the test suite (tests never touch DATABASE_URL).
# Defaults to postgresql+psycopg://localhost:5432/peaksift_test when unset.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/peaksift_test

# Signs authentication tokens. REQUIRED, at least 32 characters, unique per environment.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Directory for uploaded media in local development (relative to backend/). Never committed.
MEDIA_ROOT=./media

# Largest accepted source video in bytes (default 2 GiB).
# MAX_VIDEO_UPLOAD_BYTES=2147483648
# Music and sound-effect uploads (users upload audio they own or may use).
# AUDIO_UPLOAD_MAX_BYTES=104857600
# AUDIO_UPLOAD_MAX_DURATION_SECONDS=1200
# AUDIO_SFX_MAX_DURATION_SECONDS=30

# ffprobe binary used to read uploaded video metadata, and the per-file time limit.
# FFPROBE_PATH=ffprobe
# FFPROBE_TIMEOUT_SECONDS=30

# ffmpeg binary used to extract normalized audio for transcription, and its time limit.
# FFMPEG_PATH=ffmpeg
# AUDIO_EXTRACTION_TIMEOUT_SECONDS=3600

# Long audio is transcribed in fixed chunks of this many seconds (10 min ≈ 4.8 MB at 64 kbps).
# TRANSCRIPTION_CHUNK_SECONDS=600

# Pipeline: in-task retries for transient provider errors, stale-job threshold, prompt tail.
# TRANSCRIPTION_PROVIDER_MAX_ATTEMPTS=3
# TRANSCRIPTION_RETRY_BACKOFF_SECONDS=2
# TRANSCRIPTION_STALE_AFTER_SECONDS=1800
# TRANSCRIPTION_PROMPT_TAIL_CHARS=200
# TRANSCRIPTION_TIMESTAMP_TOLERANCE_SECONDS=1.5

# Speech-to-text provider for the transcription pipeline: faster_whisper (local) or openai.
TRANSCRIPTION_PROVIDER=faster_whisper

# faster-whisper (local provider). Loaded lazily in the Celery worker only; CPU works on macOS.
# Models download on first use (~460 MB for "small"); "tiny" is enough to try the mechanics.
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=5

# OpenAI (hosted provider). Only needed when TRANSCRIPTION_PROVIDER=openai. Never commit a key.
# The pipeline uses OPENAI_TIMESTAMP_MODEL (whisper-1) because it returns segment timestamps;
# gpt-4o-transcribe / gpt-4o-mini-transcribe return text only and cannot time clips.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_HIGH_ACCURACY_MODEL=gpt-4o-transcribe
OPENAI_TIMESTAMP_MODEL=whisper-1
# OPENAI_TIMEOUT_SECONDS=600
# OPENAI_MAX_UPLOAD_BYTES=20971520

# --- AI clip detection -------------------------------------------------------------------
# Users pick a provider and model in the UI, but only from these server-side allow-lists
# (comma-separated; the first entry is the default). Endpoints and keys are never client input.

# Local provider: an Ollama-compatible endpoint (install Ollama, then `ollama pull llama3.2:3b`).
CLIP_DETECTION_OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLIP_MODELS=llama3.2:3b
# OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_NUM_CTX=8192

# Hosted provider: OpenAI structured outputs; needs OPENAI_API_KEY above.
OPENAI_CLIP_MODELS=gpt-5-mini,gpt-5
# OPENAI_CLIP_TIMEOUT_SECONDS=120
# OPENAI_CLIP_MAX_OUTPUT_TOKENS=4000

# Analysis windows (one model request each), clip bounds, result count, retries, staleness.
# CLIP_DETECTION_WINDOW_SECONDS=300
# CLIP_DETECTION_WINDOW_OVERLAP_SECONDS=20
# CLIP_DETECTION_WINDOW_MAX_CHARS=8000
# CLIP_DETECTION_MAX_WINDOWS=500
# CLIP_DETECTION_MIN_CLIP_SECONDS=15
# CLIP_DETECTION_MAX_CLIP_SECONDS=90
# CLIP_DETECTION_TARGET_CANDIDATES=10
# CLIP_DETECTION_CANDIDATES_PER_WINDOW=3
# CLIP_DETECTION_OVERLAP_THRESHOLD=0.5
# CLIP_DETECTION_TIMESTAMP_TOLERANCE_SECONDS=1
# CLIP_DETECTION_PROVIDER_MAX_ATTEMPTS=3
# CLIP_DETECTION_RETRY_BACKOFF_SECONDS=2
# CLIP_DETECTION_STALE_AFTER_SECONDS=900   (keep above the slowest single-window analysis)
# CLIP_DETECTION_MAX_ATTEMPTS=5

# --- Clip rendering -----------------------------------------------------------------------
# Generated clips are fast-start MP4, H.264 (libx264, yuv420p) + AAC when the source has audio,
# at the source resolution/orientation, rendered on the CPU by the Celery worker.
# CLIP_RENDER_PRESET=veryfast
# CLIP_RENDER_CRF=20
# CLIP_AUDIO_BITRATE=128k
# CLIP_RENDER_TIMEOUT_SECONDS=1800
# CLIP_RENDER_DURATION_TOLERANCE_SECONDS=1
# CLIP_RENDER_SOURCE_TOLERANCE_SECONDS=1
# CLIP_RENDER_HEARTBEAT_SECONDS=15
# CLIP_RENDER_STALE_AFTER_SECONDS=900
# CLIP_RENDER_MAX_ATTEMPTS=5

# --- Short-form editing -------------------------------------------------------------------
# 9:16 shorts (1080x1920) reuse the CLIP_RENDER_* settings above. Burned-in captions need an
# FFmpeg with libass (Homebrew: ffmpeg-full, then point FFMPEG_PATH/FFPROBE_PATH at
# /opt/homebrew/opt/ffmpeg-full/bin/) and an installed caption font (Noto Sans; never commit
# font files). The worker refuses captioned renders it cannot actually draw.
# CAPTION_FONT_FAMILY=Noto Sans
# CAPTION_MAX_WORDS=7
# CAPTION_MAX_CHARS=32

# --- Smart reframing (Milestone 7) -------------------------------------------------------
# Server configuration only; users never pick a detector, model file or tuning value.
# REFRAME_DETECTOR=yunet_face        (OpenCV Zoo YuNet face detector, MIT; runs on onnxruntime)
# REFRAME_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
#   fetch once with: python scripts/fetch_reframe_model.py  (pinned URL, sha256-verified)
# REFRAME_SAMPLE_FPS=2              (frames analysed per clip second)
# REFRAME_ANALYSIS_WIDTH=640        (frames are downscaled to this width for detection)
# REFRAME_MIN_DETECTION_CONFIDENCE=0.5
# REFRAME_FACE_MARGIN=0.12          (min gap between a framed face and the crop edge, crop widths)
# REFRAME_DEAD_ZONE=0.10            (subject drift tolerated before the crop follows, crop widths)
# REFRAME_SMOOTHING_SECONDS=0.5     (exponential smoothing time constant)
# REFRAME_MAX_PAN_PER_SECOND=0.35   (crop-centre speed limit, panned-axis fractions per second)
# REFRAME_MAX_GAP_SECONDS=1.5       (a lost subject stops steering after this long)
# REFRAME_SAMPLING_TIMEOUT_SECONDS=600
# REFRAME_HEARTBEAT_SECONDS=15
# REFRAME_STALE_AFTER_SECONDS=900
# REFRAME_MAX_ATTEMPTS=5

# --- Word-timed captions (Milestone 8) ---------------------------------------------------
# Word timestamps come from the clip's own audio. The provider is server configuration and
# reuses the FASTER_WHISPER_* model settings above (one loaded model per worker).
# CAPTION_TIMING_PROVIDER=faster_whisper
# CAPTION_TIMING_TOLERANCE_SECONDS=0.25  (a word may end this far past the clip audio)
# CAPTION_TIMING_STALE_AFTER_SECONDS=900
# CAPTION_TIMING_MAX_ATTEMPTS=5

# Redis, used as the Celery broker for background transcription jobs.
REDIS_URL=redis://localhost:6379/0

# Limits for one transcription job (seconds). Multi-hour streams on CPU take hours.
# CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=21600
# CELERY_TASK_TIME_LIMIT_SECONDS=22200

# How long a login lasts, in minutes (default: 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
