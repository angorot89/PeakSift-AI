# ---------- Environment variables / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
# TLS material for the production stack (deploy/scripts/dev-certs.sh writes here)
deploy/certs/

# ---------- Model weights (fetched by scripts, never committed) ----------
*.onnx
*.tflite
backend/models/
# Caption fonts (fetched by scripts/fetch_caption_fonts.py, never committed)
backend/fonts/
# The built-in library (installed by scripts/fetch_library.py, never committed)
backend/library/

