# Copy to `.env` and fill in values. Never commit `.env`.

APP_ENV=development

# Origin allowed by CORS (the Next.js dev server).
FRONTEND_URL=http://localhost:3000

# SQLAlchemy connection URL. The example below matches the Docker Compose database.
# For a local PostgreSQL that trusts your OS user: postgresql+psycopg://localhost:5432/peaksift
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/peaksift

# Separate database used by the test suite (tests never touch DATABASE_URL).
# Defaults to postgresql+psycopg://localhost:5432/peaksift_test when unset.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/peaksift_test

# Signs authentication tokens. REQUIRED, at least 32 characters, unique per environment.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Directory for uploaded media in local development (relative to backend/). Never committed.
MEDIA_ROOT=./media

# Largest accepted source video in bytes (default 2 GiB).
# MAX_VIDEO_UPLOAD_BYTES=2147483648

# ffprobe binary used to read uploaded video metadata, and the per-file time limit.
# FFPROBE_PATH=ffprobe
# FFPROBE_TIMEOUT_SECONDS=30

# ffmpeg binary used to extract normalized audio for transcription, and its time limit.
# FFMPEG_PATH=ffmpeg
# AUDIO_EXTRACTION_TIMEOUT_SECONDS=3600

# Speech-to-text provider for the transcription pipeline: faster_whisper (local) or openai.
TRANSCRIPTION_PROVIDER=faster_whisper

# faster-whisper (local provider). Loaded lazily in the Celery worker only; CPU works on macOS.
# Models download on first use (~460 MB for "small"); "tiny" is enough to try the mechanics.
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=5

# OpenAI (hosted provider). Only needed when TRANSCRIPTION_PROVIDER=openai. Never commit a key.
# The pipeline uses OPENAI_TIMESTAMP_MODEL (whisper-1) because it returns segment timestamps;
# gpt-4o-transcribe / gpt-4o-mini-transcribe return text only and cannot time clips.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_HIGH_ACCURACY_MODEL=gpt-4o-transcribe
OPENAI_TIMESTAMP_MODEL=whisper-1
# OPENAI_TIMEOUT_SECONDS=600
# OPENAI_MAX_UPLOAD_BYTES=20971520

# Redis, used as the Celery broker for background transcription jobs.
REDIS_URL=redis://localhost:6379/0

# Limits for one transcription job (seconds). Multi-hour streams on CPU take hours.
# CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=21600
# CELERY_TASK_TIME_LIMIT_SECONDS=22200

# How long a login lasts, in minutes (default: 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
